ETAPA 3 — Executar os experimentos

Agora vamos juntar tudo.

Podemos fazer uma função para evitar repetir código.

def executar_experimento(tamanho):

    original = [random.randint(1, 10000) for _ in range(tamanho)]

    vetor_bubble = original.copy()
    vetor_insertion = original.copy()
    vetor_selection = original.copy()
    vetor_quick = original.copy()

    bubble_comp, bubble_trocas = bubble_sort(vetor_bubble)

    insertion_comp, insertion_mov = insertion_sort(vetor_insertion)

    selection_comp, selection_trocas = selection_sort(vetor_selection)

    quick_comp, quick_mov = quick_sort(vetor_quick)

    return (
        tamanho,
        bubble_comp,
        bubble_trocas,
        insertion_comp,
        insertion_mov,
        selection_comp,
        selection_trocas,
        quick_comp,
        quick_mov
    )

Agora executamos para os três tamanhos:

resultado_10 = executar_experimento(10)

resultado_20 = executar_experimento(20)

resultado_1000 = executar_experimento(1000)

print(resultado_10)
print(resultado_20)
print(resultado_1000)
